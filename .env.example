# Cloud save (optional). Without these, ForgeFuel stays on the local IndexedDB vault.
# 1. Create a free project at https://supabase.com
# 2. Run supabase/migrations/001_init.sql in the SQL Editor
# 3. Enable Email auth (Authentication → Providers → Email)
# 4. Paste Project URL + anon public key below
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
